From 758a8267dc3b8b40fd2edf39bbaeff024ff66045 Mon Sep 17 00:00:00 2001
From: Wolf Vollprecht <w.vollprecht@gmail.com>
Date: Mon, 9 Nov 2026 22:25:58 +0100
Subject: [PATCH] Find Threads before importing IlmBase targets

IlmBase::IlmThread links Threads::Threads. Downstream find_package(IlmBase) must create that dependency before importing the exported targets.
---
 IlmBase/config/IlmBaseConfig.cmake.in | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/IlmBase/config/IlmBaseConfig.cmake.in b/IlmBase/config/IlmBaseConfig.cmake.in
index 9c15f36..0d99577 100644
--- a/IlmBase/config/IlmBaseConfig.cmake.in
+++ b/IlmBase/config/IlmBaseConfig.cmake.in
@@ -1,4 +1,7 @@
 @PACKAGE_INIT@
 
+include(CMakeFindDependencyMacro)
+find_dependency(Threads)
+
 include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
 check_required_components("@PROJECT_NAME@")
-- 
2.56.0

